+
+  try {
+    if (granted) {
+      window.localStorage.setItem(ACCESS_STORAGE_KEY, "true");
+      return;
+    }
+
+    window.localStorage.removeItem(ACCESS_STORAGE_KEY);
+  } catch {
+    // Ignore storage failures and keep the gate usable for the current page load.
+  }
+}
