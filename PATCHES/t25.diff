+        ('thread-4', '/tmp/4.jsonl', 1773018000, 1773018240, 'vscode', 'openai', '/workspace/d', 'aborted', 'danger', 'never', 100, 1, 0, NULL);
+    `,
+  ]);
+
+  writeJsonl(path.join(codexHome, "sessions", "2026", "03", "09", "thread-1.jsonl"), [
